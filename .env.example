# Environment Variables for Darukaa.Earth

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darukaa_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=darukaa_db
DB_HOST=localhost
DB_PORT=5432

# Security & Authentication
JWT_SECRET_KEY=super-secret-darukaa-earth-key-change-in-production-min32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Geospatial / Mapbox
# Get a free public token from https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGFydWthYSIsImEiOiJjbHNnd2R2eGIwMXQ0MmxzNW5zMGQza3F4In0.sample_token_replace_me
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGFydWthYSIsImEiOiJjbHNnd2R2eGIwMXQ0MmxzNW5zMGQza3F4In0.sample_token_replace_me

# Frontend / API URLs
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
